# Copy → .env (hoặc export trước khi start)

# user-service DB
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_USER=recipes
USER_DB_PASSWORD=recipes
USER_DB_NAME=users_db

# recipe-service DB
RECIPE_DB_HOST=localhost
RECIPE_DB_PORT=5432
RECIPE_DB_USER=recipes
RECIPE_DB_PASSWORD=recipes
RECIPE_DB_NAME=recipes_db

# Service URLs
USER_SERVICE_URL=http://localhost:3001
RECIPE_SERVICE_URL=http://localhost:3002

# JWT (đổi secret trước khi deploy thật)
JWT_ACCESS_SECRET=homecook-dev-access-secret-change-me
JWT_REFRESH_SECRET=homecook-dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP → Mailpit (local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@homecook.local

# Cloudinary (recipe/ingredient media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=Home/home-cook
# Optional: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
